{
  "application": "InvoiceFlow",
  "application_id": "invoiceflow",
  "bugs": [
    {
      "id": "INV-001",
      "category": "business_logic",
      "difficulty": "medium",
      "severity": "high",
      "affected_component": "invoice_calculation",
      "description": "Tax is calculated on the pre-discount subtotal instead of the discounted amount.",
      "trigger_conditions": [
        "Invoice with both discount_pct and tax_pct"
      ],
      "reproduction_steps": [
        "Create invoice 10x$10 with discount 20% and tax 10%",
        "Read total"
      ],
      "expected_behavior": "Total 8800 cents (tax on 8000)",
      "expected_result": "Total 8800 cents (tax on 8000)",
      "actual_result": "Total 9000 cents (tax on 10000)",
      "multi_step": false
    },
    {
      "id": "INV-002",
      "category": "frontend",
      "difficulty": "easy",
      "severity": "medium",
      "affected_component": "invoice_list_pagination",
      "description": "Page count uses floor, so the last partial page is unreachable.",
      "trigger_conditions": [
        "Total invoices not a multiple of page size"
      ],
      "reproduction_steps": [
        "Open Invoices tab with 23 invoices",
        "Observe pager"
      ],
      "expected_behavior": "3 pages",
      "expected_result": "3 pages",
      "actual_result": "2 pages; invoices 21-23 unreachable",
      "multi_step": false
    },
    {
      "id": "INV-003",
      "category": "backend",
      "difficulty": "easy",
      "severity": "medium",
      "affected_component": "invoice_validation",
      "description": "Invoices with no line items are accepted.",
      "trigger_conditions": [
        "POST /api/invoices with items=[] or missing"
      ],
      "reproduction_steps": [
        "POST invoice with empty items"
      ],
      "expected_behavior": "400 validation error",
      "expected_result": "400 validation error",
      "actual_result": "201 with zero total invoice",
      "multi_step": false
    },
    {
      "id": "INV-004",
      "category": "security",
      "difficulty": "medium",
      "severity": "critical",
      "affected_component": "invoice_authorization",
      "description": "GET /api/invoices/<id> does not scope by organization (cross-tenant read).",
      "trigger_conditions": [
        "Authenticated user of org A requests id of org B"
      ],
      "reproduction_steps": [
        "Login as admin@globex.test",
        "GET /api/invoices/1"
      ],
      "expected_behavior": "404",
      "expected_result": "404",
      "actual_result": "200 with Acme invoice",
      "multi_step": false
    },
    {
      "id": "INV-005",
      "category": "business_logic",
      "difficulty": "hard",
      "severity": "high",
      "affected_component": "refunds",
      "description": "Refunding a payment leaves the invoice in 'paid' status although the balance is reopened.",
      "trigger_conditions": [
        "Refund a payment on a fully paid invoice"
      ],
      "reproduction_steps": [
        "Create+send invoice",
        "Pay in full",
        "Refund payment",
        "Read invoice"
      ],
      "expected_behavior": "balance restored and status 'sent'/'partially_paid'",
      "expected_result": "balance restored and status 'sent'/'partially_paid'",
      "actual_result": "balance restored but status still 'paid' (cannot be paid again)",
      "multi_step": true
    },
    {
      "id": "INV-006",
      "category": "business_logic",
      "difficulty": "very_hard",
      "severity": "high",
      "affected_component": "revenue_report",
      "description": "Monthly revenue report excludes payments dated on the last day of the month (exclusive end is the last day, not the first of next month).",
      "trigger_conditions": [
        "Payment with paid_on on the final day of a month"
      ],
      "reproduction_steps": [
        "Create+send invoice",
        "Record payment with paid_on=2026-02-28",
        "GET /api/reports/revenue?month=2026-02"
      ],
      "expected_behavior": "Revenue includes the payment",
      "expected_result": "Revenue includes the payment",
      "actual_result": "Revenue is 0 for that payment",
      "multi_step": true
    }
  ]
}
