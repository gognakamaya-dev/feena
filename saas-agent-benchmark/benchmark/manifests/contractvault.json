      "category": "backend",
      "difficulty": "medium",
      "severity": "medium",
      "affected_component": "expiring_report",
      "description": "Expiring report excludes contracts ending exactly on the last day of the window.",
      "trigger_conditions": [
        "end_date == today + days"
      ],
      "reproduction_steps": [
        "GET /api/reports/expiring?days=91 (contract 6 ends day 91)"
      ],
