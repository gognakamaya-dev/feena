      "description": "Contract form validation does not check end date against start date.",
      "trigger_conditions": [
        "end_date before start_date"
      ],
      "reproduction_steps": [
        "Enter start 2026-05-01 end 2026-04-01 in New contract form"
      ],
      "expected_behavior": "Validation error",
      "expected_result": "Validation error",
      "actual_result": "Form passes validation",
      "multi_step": false
    },
    {
