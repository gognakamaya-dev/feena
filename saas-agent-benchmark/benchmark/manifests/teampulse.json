      "description": "team_id filter is ignored when a search query is present.",
      "trigger_conditions": [
        "q and team_id both set"
      ],
      "reproduction_steps": [
        "GET /api/employees?team_id=1&q=Employee"
      ],
      "expected_behavior": "Only team 1 employees",
