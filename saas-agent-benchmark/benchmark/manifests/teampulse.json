      "difficulty": "easy",
      "severity": "low",
      "affected_component": "headcount_summary",
      "description": "Headcount summary counts terminated employees.",
      "trigger_conditions": [
        "Terminated employee in list"
      ],
      "reproduction_steps": [
        "Open Employees tab"
