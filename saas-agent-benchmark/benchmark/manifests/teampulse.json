    {
      "id": "TP-006",
      "category": "business_logic",
      "difficulty": "hard",
      "severity": "high",
      "affected_component": "rehire",
      "description": "Rehiring leaves terminated_on set so headcount analytics keep excluding the employee.",
      "trigger_conditions": [
        "Terminate then rehire"
      ],
      "reproduction_steps": [
        "GET headcount",
        "Terminate employee",
        "Rehire",
        "GET headcount"
      ],
      "expected_behavior": "headcount back to original",
      "expected_result": "headcount back to original",
      "actual_result": "headcount remains reduced",
      "multi_step": true
