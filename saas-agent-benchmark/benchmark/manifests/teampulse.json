      "description": "Pulse score range (1-5) is not enforced.",
      "trigger_conditions": [
        "score 9 or 0"
      ],
      "reproduction_steps": [
        "POST /api/pulse {score:9}"
      ],
      "expected_behavior": "400",
      "expected_result": "400",
      "actual_result": "201",
      "multi_step": false
    },
    {
