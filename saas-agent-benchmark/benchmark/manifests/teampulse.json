      "description": "salary_band is exposed to non-admin roles.",
      "trigger_conditions": [
        "Member lists employees"
      ],
      "reproduction_steps": [
        "Login as member",
        "GET /api/employees"
      ],
      "expected_behavior": "salary_band omitted",
      "expected_result": "salary_band omitted",
      "actual_result": "salary_band present",
      "multi_step": false
    },
