  "bugs": [
    {
      "id": "TB-001",
      "category": "frontend",
      "difficulty": "easy",
      "severity": "low",
      "affected_component": "task_search",
      "description": "Client-side task search is case-sensitive.",
      "trigger_conditions": [
        "Search text whose case differs from the title"
      ],
      "reproduction_steps": [
        "Open Tasks",
        "Search 'login'",
        "Observe 'Fix Login bug' missing"
      ],
      "expected_behavior": "Case-insensitive match",
      "expected_result": "Case-insensitive match",
      "actual_result": "No match unless case is identical",
      "multi_step": false
    },
    {
      "id": "TB-002",
      "category": "backend",
      "difficulty": "easy",
      "severity": "medium",
      "affected_component": "task_update_validation",
      "description": "PATCH /api/tasks/<id> accepts arbitrary status strings.",
      "trigger_conditions": [
        "status not in todo/doing/done"
      ],
      "reproduction_steps": [
        "PATCH task with status 'banana'"
      ],
      "expected_behavior": "400 validation error",
      "expected_result": "400 validation error",
      "actual_result": "200 and task stored with status 'banana'",
      "multi_step": false
    },
    {
      "id": "TB-003",
      "category": "database",
      "difficulty": "medium",
      "severity": "medium",
      "affected_component": "project_stats",
      "description": "Project stats count soft-deleted tasks in status buckets.",
      "trigger_conditions": [
        "At least one deleted task"
      ],
      "reproduction_steps": [
        "Create task",
        "Delete it",
        "GET /stats"
      ],
      "expected_behavior": "Status buckets equal the visible task count",
      "expected_result": "Status buckets equal the visible task count",
      "actual_result": "Deleted task still counted in 'todo'",
      "multi_step": true
    },
