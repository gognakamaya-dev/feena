      "trigger_conditions": [
        "Parent with 2+ subtasks, first done, later open"
      ],
      "reproduction_steps": [
        "Create parent",
        "Add two subtasks",
        "Complete first subtask",
        "Complete parent"
      ],
      "expected_behavior": "409 until all subtasks done",
      "expected_result": "409 until all subtasks done",
      "actual_result": "Parent marked done with open subtask",
